{
  "expo": {
    "name": "OpenMatch",
    "slug": "openmatch",
    "version": "0.1.0",
    "scheme": "openmatch",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "org.openmatch.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "OpenMatch connects to your development Mac to load the private test service.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "org.openmatch.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FAFAF7"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5c1bb2c-19ef-43bb-831e-a812f876ee87"
      }
    }
  }
}
