# Bind only to localhost by default. On myna-1 this is its Tailnet address.
OPENMATCH_BIND_ADDRESS=127.0.0.1
OPENMATCH_GATEWAY_PORT=54321
OPENMATCH_MAILPIT_PORT=8025
OPENMATCH_WEB_PORT=3000

# These URLs must use the same host/port visible to the browser or mobile app.
OPENMATCH_AUTH_URL=http://127.0.0.1:54321/auth/v1
OPENMATCH_API_URL=http://127.0.0.1:54321
OPENMATCH_SITE_URL=http://127.0.0.1:3000
OPENMATCH_REDIRECT_URLS=http://127.0.0.1:3000/**,openmatch://**
OPENMATCH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Leave these blank for the bundled development services. In a hosted Supabase
# deployment, set the Auth URL, client key, service-role key, and pooled
# PostgreSQL connection string.
OPENMATCH_SUPABASE_AUTH_URL=
OPENMATCH_SUPABASE_ANON_KEY=
OPENMATCH_SUPABASE_SERVICE_ROLE_KEY=
OPENMATCH_HOSTED_POSTGRES_URL=
# Set this to the deployed 7–40 character Git commit so the transparency API
# can identify the exact source. Leave empty only for unpinned local work.
OPENMATCH_COMMIT_SHA=

POSTGRES_DB=openmatch
POSTGRES_USER=openmatch_auth
POSTGRES_PASSWORD=replace-with-a-random-secret
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY=3600
SMTP_FROM=auth@openmatch.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=WhyMatch

# Production example (use a dedicated WhyMatch Brevo SMTP key, not an API key):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=no-reply@auth.your-whymatch-domain.example
