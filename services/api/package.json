{
  "name": "@openmatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@openmatch/matching": "workspace:*",
    "nodemailer": "^9.0.5"
  },
  "scripts": {
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
