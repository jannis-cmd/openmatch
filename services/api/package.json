    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
