{
  "name": "@openmatch/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform ios && expo export --platform android",
    "eas-build-pre-install": "node ./scripts/verify-eas-environment.mjs",
    "eas-build-post-install": "pnpm --dir ../.. build:packages",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand && node --test ./scripts/*.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.19",
    "@openmatch/api-client": "workspace:*",
    "@openmatch/matching": "workspace:*",
    "expo": "^56.0.19",
    "expo-constants": "~56.0.23",
    "expo-crypto": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-router": "^56.2.18",
    "expo-secure-store": "~56.0.4",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.2.1",
    "@types/react": "~19.2.18",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@openmatch/matching$": "<rootDir>/../../packages/matching/src/index.ts",
      "^@openmatch/api-client$": "<rootDir>/../../packages/api-client/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-router|@react-navigation/.*|react-navigation|react-native-safe-area-context|react-native-screens))"
    ]
  }
}
